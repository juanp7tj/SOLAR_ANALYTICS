# Copie este arquivo para .env. Não armazene o AppSecret GoodWe aqui.
SOLAR_DATA_DIR=./data
SOLAR_DEMO_AUTOLOAD=true
SOLAR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Opcional: origens adicionais exatas autorizadas a enviar operações de escrita.
SOLAR_TRUSTED_WRITE_ORIGINS=
# Ative no Preview Cloud ou ao expor a API para ocultar /docs, /redoc e /openapi.json.
SOLAR_DISABLE_API_DOCS=false
