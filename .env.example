# Copie para .env apenas para desenvolvimento local. Nunca envie .env para o GitHub.
SOLAR_DATA_DIR=./data
SOLAR_BACKUP_DIR=./backups
SOLAR_DEMO_AUTOLOAD=true
SOLAR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Origens exatas adicionais autorizadas; o domínio RENDER_EXTERNAL_URL é adicionado automaticamente.
SOLAR_TRUSTED_WRITE_ORIGINS=
# No uso local, mantenha o login desativado e acesse somente por localhost.
SOLAR_AUTH_REQUIRED=false
SOLAR_ADMIN_USERNAME=
SOLAR_ADMIN_PASSWORD=
SOLAR_SESSION_SECRET=
SOLAR_COOKIE_SECURE=false
SOLAR_VOLATILE_STORAGE=false
SOLAR_DISABLE_API_DOCS=false
